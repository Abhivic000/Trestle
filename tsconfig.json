{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // Root config files are loaded directly by Node/Vite, which need real extensions.
    "allowImportingTsExtensions": true
  },
  "include": ["vitest.config.ts", "playwright.config.ts", "e2e", "test-support"]
}
