# Copy this file to `.env` (same folder) and fill in real values.
# Only variables starting with VITE_ reach the browser, and anything that
# reaches the browser is PUBLIC. Never put secret keys in this file.

# Where the Trestle API runs.
VITE_API_URL=http://localhost:4000

# Supabase → Project Settings → API Keys / Connect dialog.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# PUBLISHABLE key (starts with sb_publishable_). Safe for the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
