# Copy to `.env.test` (same folder) and fill in the values of the SEPARATE
# "trestle-test" Supabase project. Never point this at your real project:
# tests create and delete users and data freely.

# Different port than dev so tests never talk to your running dev server.
PORT=4001
WEB_ORIGIN=http://localhost:5174

# trestle-test → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.your-test-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# trestle-test → Project Settings → API Keys.
SUPABASE_URL=https://your-test-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Only used by tests, to prove the browser key can't read tables directly.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Not used by tests yet; any non-empty value works.
GEMINI_API_KEY=unused-in-tests
