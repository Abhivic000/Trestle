# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. Never commit real keys.

# Port the API listens on locally.
PORT=4000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# The web app's address, allowed to call this API from the browser (CORS).
WEB_ORIGIN=http://localhost:5173

# Supabase → Connect → "Session pooler" connection string (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password; URL-encode special characters.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API Keys / Connect dialog.
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET key (starts with sb_secret_). Server only: bypasses all access rules.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Google AI Studio → Get API key. Keep billing OFF on its project to stay free.
GEMINI_API_KEY=replace_me
